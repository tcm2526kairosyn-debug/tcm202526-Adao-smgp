# Copiar para .env e preencher os valores reais (nunca fazer commit do .env)

# Segurança — gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substituir-por-valor-aleatorio

# Base de dados (Railway preenche automaticamente)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email (Resend API — https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=email-do-administrador@exemplo.com
# Opcional: endereço de envio (requer domínio verificado no Resend)
# RESEND_FROM=KairoSyn SAD <noreply@seudominio.com>

# URL base da aplicação (Railway gera automaticamente)
FLASK_BASE_URL=https://tcm202526.up.railway.app

# Flask
FLASK_APP=app:create_app
